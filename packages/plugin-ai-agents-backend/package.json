{
  "name": "@acarmisc/backstage-plugin-ai-agents-backend",
  "version": "0.4.0",
  "description": "Backstage backend plugin for AI Agents live status probing and invocations.",
  "keywords": [
    "backstage",
    "backstage-plugin",
    "backstage-backend-plugin"
  ],
  "backstage": {
    "role": "backend-plugin",
    "pluginId": "ai-agents",
    "pluginPackages": [
      "@acarmisc/backstage-plugin-ai-agents-backend"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/acarmisc/backstage-plugin-ai-agents"
  },
  "homepage": "https://github.com/acarmisc/backstage-plugin-ai-agents#readme",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.cjs.js"
    }
  },
  "main": "dist/index.cjs.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "config.d.ts"
  ],
  "scripts": {
    "build": "node build.js && tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/**/*.test.js dist-test/*.test.js",
    "lint": "backstage-cli package lint",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build",
    "postpack": ""
  },
  "dependencies": {
    "@backstage/backend-plugin-api": "^1.9.1",
    "@backstage/catalog-client": "^1.9.0",
    "@backstage/catalog-model": "^1.7.0",
    "@backstage/config": "^1.3.0",
    "@backstage/plugin-permission-common": "^0.9.9",
    "express": "^4.18.2",
    "knex": "^3.1.0"
  },
  "devDependencies": {
    "@backstage/cli": "^0.36.2",
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.43",
    "esbuild": "^0.28.0",
    "typescript": "^5.9.3"
  },
  "configSchema": "config.d.ts"
}
