{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "declaration": false,
    "outDir": "dist-test",
    "rootDir": "src",
    "skipLibCheck": true
  },
  "include": ["src/**/*.test.ts"],
  "exclude": ["node_modules", "dist"]
}