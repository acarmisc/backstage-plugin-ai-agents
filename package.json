{
  "name": "@acarmisc/backstage-plugin-ai-agents-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "AI Agents management plugin for Backstage — agents as catalog Components with a dedicated card view.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
